<Window x:Class="StreamControlCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StreamControlCSharp.ViewModels"
        mc:Ignorable="d"
        Title="StreamControlC#" Height="700" Width="1060"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0D0E11" Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F1" Command="{Binding ScoreP1PlusCommand}" />
        <KeyBinding Modifiers="Shift" Key="F1" Command="{Binding ScoreP1MinusCommand}" />
        <KeyBinding Key="F2" Command="{Binding ScoreP2PlusCommand}" />
        <KeyBinding Modifiers="Shift" Key="F2" Command="{Binding ScoreP2MinusCommand}" />
        <KeyBinding Key="F5" Command="{Binding SwapPlayersCommand}" />
        <KeyBinding Key="F6" Command="{Binding ResetScoresCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Broadcast Titanium & Obsidian Theme -->
        <SolidColorBrush x:Key="BgDark" Color="#0D0E11"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#121418"/>
        <SolidColorBrush x:Key="HeaderBorder" Color="#1E222A"/>
        <SolidColorBrush x:Key="CardBg" Color="#16181D"/>
        <SolidColorBrush x:Key="CardBorder" Color="#252833"/>
        <SolidColorBrush x:Key="InputBg" Color="#101216"/>
        <SolidColorBrush x:Key="InputBorder" Color="#21242E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FB7185"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#34D399"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#818CF8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===================== ComboBox (tema oscuro del proyecto) =====================
             La plantilla por defecto de Windows pinta el cuadro de edición y el desplegable
             de blanco, así que el texto blanco del ComboBox quedaba invisible al escribir.
             Estas plantillas mantienen cerrado, edición, flecha y lista con la paleta. -->

        <!-- Fondo + flecha del combo (el toggle también abre/cierra la lista) -->
        <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#94A3B8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#161A21"/>
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3A4050"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Cuadro de texto que se usa cuando el combo es editable -->
        <Style x:Key="ComboBoxEditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="SelectionBrush" Value="#4338CA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de scroll del desplegable (la de Windows es blanca y rompe el tema) -->
        <Style x:Key="ComboScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3A4050" CornerRadius="4" Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <!-- Texto del ítem seleccionado (combo cerrado, no editable) -->
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="9,0,27,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="#FFFFFF"/>

                            <!-- Texto editable: fondo oscuro, texto claro y cursor azul.
                                 El Text va enlazado al ComboBox en TwoWay para que muestre el
                                 valor actual (ronda/texto) y devuelva lo que se escribe. -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{StaticResource ComboBoxEditableTextBoxStyle}"
                                     Margin="1,1,25,1"
                                     Focusable="True"
                                     Visibility="Collapsed"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="3">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  Background="Transparent"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ComboScrollBarStyle}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Sin texto no mostramos un tooltip vacío -->
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ítems del desplegable: fondo oscuro, hover y selección con acento -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E2129"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2B2F3B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#312E81"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4338CA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2129"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2B2F3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,8,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ficha de un set dentro de la tarjeta "Sets del torneo por fase" -->
        <Style x:Key="SetChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#14161B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#262A35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Width" Value="292"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="Chip" Property="Background" Value="#1B2030"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#232A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header (Clean Bar with Save Button) -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource HeaderBorder}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveCommand}" Background="#4338CA" BorderBrush="#6366F1" Foreground="#FFFFFF" BorderThickness="1" Padding="16,7" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GUARDAR EN OBS" Margin="0,0,6,0"/>
                            <TextBlock Text="(Ctrl+S)" FontSize="11" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="14,10">

            <!-- TAB 1: SCOREBOARD -->
            <TabItem Header="SCOREBOARD">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">

                        <!-- Main Scoreboard Card -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Player 1 Section (Cobalt Precision) -->
                                <Border Grid.Column="0" Background="#12151B" BorderBrush="#1E2D45" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="JUGADOR 1" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" FontSize="13" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="Tag / Sponsor" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Data.P1Team, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                                        <TextBlock Text="Nombre de Jugador" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Data.PName1, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="Bold" Margin="0,2,0,8"/>

                                        <TextBlock Text="País (Bandera)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Data.PCountry1, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,14"/>

                                        <!-- Score Controls Header -->
                                        <TextBlock Text="MARCADOR" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="11" Margin="0,0,0,4"/>
                                        
                                        <!-- Main Score Row: [-] [SCORE] [+1 PUNTO] -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding ScoreP1MinusCommand}" Content="-" Height="44" FontSize="20" Background="#181B22" BorderBrush="#252A36" ToolTip="Restar 1 punto (Shift+F1)"/>
                                            <TextBox Grid.Column="1" Text="{Binding Data.PScore1, UpdateSourceTrigger=PropertyChanged}" Height="44" FontSize="26" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Background="#0E1014" BorderBrush="#1E2D45" Margin="6,0"/>
                                            <Button Grid.Column="2" Command="{Binding ScoreP1PlusCommand}" Height="44" Background="#1D4ED8" BorderBrush="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" ToolTip="Sumar 1 punto (F1)">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="+1 PUNTO" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text=" (F1)" FontSize="11" Foreground="#93C5FD" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Quick Presets Row: [0] [1] [2] [3] -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Rápido:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Command="{Binding SetScoreP1Command}" CommandParameter="0" Content="0" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                            <Button Command="{Binding SetScoreP1Command}" CommandParameter="1" Content="1" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                            <Button Command="{Binding SetScoreP1Command}" CommandParameter="2" Content="2" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                            <Button Command="{Binding SetScoreP1Command}" CommandParameter="3" Content="3" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Center Actions (Swap / Round / Reset) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                                    <Button Command="{Binding SwapPlayersCommand}" Height="40" Margin="0,0,0,10" Background="#1B1E26" BorderBrush="#3B4252" ToolTip="Intercambiar Jugador 1 y 2 (F5)">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⇄ SWAP" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text=" (F5)" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ResetScoresCommand}" Height="34" Margin="0,0,0,16" Background="#241B1C" BorderBrush="#4A2628" Foreground="#FCA5A5" ToolTip="Reiniciar puntajes a 0 (F6)">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="0 - 0 RESET" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text=" (F6)" FontSize="10" Foreground="#F87171" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="Ronda Actual" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Rounds}" Text="{Binding Data.Round, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"  IsTextSearchEnabled="True" 
          StaysOpenOnEdit="True" Width="136" Margin="0,2,0,10"/>

                                    <TextBlock Text="Texto Abajo" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding TextBottomOptions}" Text="{Binding Data.TextBottom, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"  IsTextSearchEnabled="True" 
          StaysOpenOnEdit="True" Width="136" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Player 2 Section (Ruby Precision) -->
                                <Border Grid.Column="2" Background="#171215" BorderBrush="#451E28" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="JUGADOR 2" FontWeight="Bold" Foreground="{StaticResource AccentRed}" FontSize="13" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="Tag / Sponsor" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Data.P2Team, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                                        <TextBlock Text="Nombre de Jugador" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Data.PName2, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="Bold" Margin="0,2,0,8"/>

                                        <TextBlock Text="País (Bandera)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Data.PCountry2, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,14"/>

                                        <!-- Score Controls Header -->
                                        <TextBlock Text="MARCADOR" FontWeight="SemiBold" Foreground="{StaticResource AccentRed}" FontSize="11" Margin="0,0,0,4"/>
                                        
                                        <!-- Main Score Row: [-] [SCORE] [+1 PUNTO] -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding ScoreP2MinusCommand}" Content="-" Height="44" FontSize="20" Background="#181B22" BorderBrush="#252A36" ToolTip="Restar 1 punto (Shift+F2)"/>
                                            <TextBox Grid.Column="1" Text="{Binding Data.PScore2, UpdateSourceTrigger=PropertyChanged}" Height="44" FontSize="26" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Background="#0E1014" BorderBrush="#451E28" Margin="6,0"/>
                                            <Button Grid.Column="2" Command="{Binding ScoreP2PlusCommand}" Height="44" Background="#BE123C" BorderBrush="#E11D48" Foreground="#FFFFFF" FontWeight="Bold" ToolTip="Sumar 1 punto (F2)">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="+1 PUNTO" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text=" (F2)" FontSize="11" Foreground="#FDA4AF" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Quick Presets Row: [0] [1] [2] [3] -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Rápido:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Command="{Binding SetScoreP2Command}" CommandParameter="0" Content="0" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                            <Button Command="{Binding SetScoreP2Command}" CommandParameter="1" Content="1" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                            <Button Command="{Binding SetScoreP2Command}" CommandParameter="2" Content="2" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                            <Button Command="{Binding SetScoreP2Command}" CommandParameter="3" Content="3" Width="34" Height="26" FontSize="11" Padding="0" Margin="2,0" Background="#161820" BorderBrush="#282C38"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Commentators Section Card -->
