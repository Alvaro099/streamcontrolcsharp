                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Configura el token y el slug del torneo y presiona «Cargar Sets por Fase»."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"
                                           Visibility="{Binding PhasesEmptyVisibility}"/>

                                <ItemsControl ItemsSource="{Binding TournamentPhases}" Visibility="{Binding PhasesListVisibility}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#1E2129" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding OrderLabel}" Foreground="{StaticResource AccentPurple}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PhaseName}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding EventName}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Error}" Foreground="#F87171" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"
                                                               Visibility="{Binding ErrorVisibility}"/>

                                                    <ItemsControl ItemsSource="{Binding Sets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource SetChipStyle}"
                                                                        Command="{Binding DataContext.LoadSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="{Binding TooltipText}">
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding RoundText}" Foreground="{StaticResource AccentPurple}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="6,0,0,0"/>
                                                                        </Grid>
                                                                        <Grid Margin="0,4,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding P1Display}" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding P2Display}" Foreground="{StaticResource AccentRed}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding P1Score}" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                                                <TextBlock Text="{Binding P2Score}" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar (Hardware Console Meter) -->
        <Border Grid.Row="2" Background="#0A0B0E" BorderBrush="#1C1F26" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Estado: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Salida: browserfiles/streamcontrol.json (UTF-8)" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
