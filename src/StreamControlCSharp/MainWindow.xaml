                                    <Button Command="{Binding SyncCurrentMatchCommand}" Content="⚡ Sincronizar Match Actual Ahora" Background="#312E81" BorderBrush="#4338CA" Foreground="#E0E7FF"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tournament Sets by Phase Card -->
                        <Border x:Name="TournamentSetsCard" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Todos los Sets del Torneo por Fase" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
